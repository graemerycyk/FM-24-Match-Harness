// GENERATED by cmake/edition.cmake for FM_EDITION=@FM_EDITION@; do not edit. Every name that tells
// the game editions apart, so the same sources build the harness for each: the sources use these,
// never the names themselves, and their comments write fmNNctl, FMNN and so on for them. Each is a
// single string literal, which the viewer's Swift imports (as the module Edition), apart from the
// numbers FM_EDITION, EDITION_ENGINE_PLUGIN and EDITION_TACTIC_PHASES.
#pragma once

#define FM_EDITION @FM_EDITION@

// The game.
#define EDITION_PRODUCT "@EDITION_PRODUCT@"                 // its short name, in messages
#define EDITION_LOWER "@EDITION_LOWER@"                     // the prefix of temporary files' names
#define EDITION_GAME "@EDITION_GAME@"                       // Steam's name and install folder
#define EDITION_GAME_VERSION "@EDITION_GAME_VERSION@"       // the version to install
#define EDITION_GAME_BUNDLE_ID "@EDITION_GAME_BUNDLE_ID@"   // the app's CFBundleIdentifier
#define EDITION_GAME_EXECUTABLE "@EDITION_GAME_EXECUTABLE@" // in the app's Contents/MacOS
#define EDITION_STEAM_APP_ID "@EDITION_STEAM_APP_ID@"
#define EDITION_DATA_FOLDER "@EDITION_DATA_FOLDER@" // under ~/Library/Application Support
// Where the match engine is: in the game's executable (0), or (1) in a plugin bundle the game loads
// once it has started, whose executable is EDITION_ENGINE_PATH under the app's Contents/PlugIns.
#define EDITION_ENGINE_PLUGIN @EDITION_ENGINE_PLUGIN@
#define EDITION_ENGINE_PATH "@EDITION_ENGINE_PATH@"
// The phases of the game's tactics: 1, where a plan's formation slots each have a position and a
// role with its duty, and tactical familiarity has seven named categories; or 2, where each slot has
// a position and a role, without duty, in possession and others out of possession, and familiarity
// has six categories, numbered.
#define EDITION_TACTIC_PHASES @EDITION_TACTIC_PHASES@

// The harness and its command line.
#define EDITION_CLI "@EDITION_CLI@"
#define EDITION_CLI_ENV "@EDITION_CLI_ENV@"       // names the CLI the viewer runs, for tests
#define EDITION_ENV_PREFIX "@EDITION_ENV_PREFIX@" // of the tests' environment variables
#define EDITION_HARNESS "@EDITION_HARNESS@"       // its folder, and its dylib's and socket's prefix
#define EDITION_LAUNCHER "@EDITION_LAUNCHER@"     // the script Steam's launch option runs
#define EDITION_SECTION "@EDITION_SECTION@"       // the CLI's __TEXT section with the dylib
#define EDITION_MATCH_CONFIG_FORMAT "@EDITION_MATCH_CONFIG_FORMAT@"
#define EDITION_PLAYER_FORMAT "@EDITION_PLAYER_FORMAT@"
// The next fixture's export that fmNNctl with no arguments and the viewer write, in the user's
// temporary directory; the viewer shows a fixture there as an unsaved export.
#define EDITION_TEMPORARY_FIXTURE "@EDITION_TEMPORARY_FIXTURE@"
// The start of the names of the files that hold one job's encoded input, or a player fetched for
// it, in the job directory: on macOS the user's temporary directory, which the editions share.
#define EDITION_JOB_INPUT_PREFIX "@EDITION_JOB_INPUT_PREFIX@"

// The macOS fixture viewer.
#define EDITION_VIEWER_NAME "@EDITION_VIEWER_NAME@"
#define EDITION_VIEWER_APP "@EDITION_VIEWER_APP@"
#define EDITION_VIEWER_EXECUTABLE "@EDITION_VIEWER_EXECUTABLE@"
#define EDITION_VIEWER_ID "@EDITION_VIEWER_ID@"
