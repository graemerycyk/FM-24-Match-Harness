# The commit the build is from (src/common/build_info.h). Included by CMakeLists.txt, this adds the
# target build_info, which runs this file as a script on every build and sets BUILD_INFO_SOURCE to
# the file it generates. The file is replaced only when its text changes, so an unchanged tree
# rebuilds nothing.
#
# As a script: SOURCE_DIR is the source tree, OUTPUT the C file to write and GIT the git executable
# ("" if there is none). The commit is HEAD of the repository whose top is SOURCE_DIR, and the tree
# is dirty if tracked files differ from it.
if(NOT CMAKE_SCRIPT_MODE_FILE)
	find_package(Git QUIET)
	set(BUILD_INFO_SOURCE "${CMAKE_BINARY_DIR}/generated/build_info.c")
	add_custom_target(build_info
		COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${CMAKE_SOURCE_DIR}" "-DOUTPUT=${BUILD_INFO_SOURCE}"
			"-DGIT=${GIT_EXECUTABLE}" -P "${CMAKE_CURRENT_LIST_FILE}"
		BYPRODUCTS "${BUILD_INFO_SOURCE}"
		COMMENT "Reading the commit the build is from"
		VERBATIM
	)
	return()
endif()

set(commit unknown)
set(dirty -1)
if(GIT)
	# The prefix is empty only at the repository's top: a tree copied into another repository's
	# folder is not that repository's commit.
	execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-parse --show-prefix HEAD
		RESULT_VARIABLE failed OUTPUT_VARIABLE head ERROR_QUIET
	)
	string(REPLACE "\r" "" head "${head}")
	if(NOT failed AND head MATCHES "^\n([0-9a-f]+)\n$")
		string(LENGTH "${CMAKE_MATCH_1}" length)
		if(length EQUAL 40)
			set(head "${CMAKE_MATCH_1}")
			# --no-optional-locks: no index refresh, which would race other git commands in the tree.
			execute_process(
				COMMAND "${GIT}" --no-optional-locks -C "${SOURCE_DIR}" status --porcelain
					--untracked-files=no
				RESULT_VARIABLE failed OUTPUT_VARIABLE changes ERROR_QUIET
			)
			if(NOT failed)
				set(commit "${head}")
				if(changes)
					set(dirty 1)
				else()
					set(dirty 0)
				endif()
			endif()
		endif()
	endif()
endif()

string(CONCAT text
	"// Generated by cmake/build_info.cmake: the commit this build is from.\n"
	"#include \"build_info.h\"\n\n"
	"const char buildInfo_commit[] = \"${commit}\";\n"
	"const int buildInfo_dirty = ${dirty};\n"
)
file(WRITE "${OUTPUT}.tmp" "${text}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}"
	RESULT_VARIABLE failed
)
file(REMOVE "${OUTPUT}.tmp")
if(failed)
	message(FATAL_ERROR "cannot write ${OUTPUT}")
endif()
