# Writes OUTPUT, a header with what the stand-in harness's tables need of the stand-in engine plugin
# PLUGIN (tests/macos_stand_in_plugin.c) for each of its ARCHITECTURES: the slice's LC_UUID (read
# with OBJDUMP) and the offsets of its engine bytes, state, vtables and stand-in engine functions
# from its header (read with NM; the plugin's __TEXT starts at 0, as the game's does).
set(text "// GENERATED by tests/macos_stand_in_offsets.cmake from the stand-in plugin; do not edit.\n")
string(APPEND text "#pragma once\n\n")
set(directive "#if")
foreach(arch IN LISTS ARCHITECTURES)
	if(arch STREQUAL "arm64")
		set(macro "__aarch64__")
	elseif(arch STREQUAL "x86_64")
		set(macro "__x86_64__")
	else()
		message(FATAL_ERROR "the stand-in plugin has an unexpected slice, ${arch}")
	endif()
	execute_process(
		COMMAND "${OBJDUMP}" --macho --private-headers "--arch=${arch}" "${PLUGIN}"
		OUTPUT_VARIABLE headers
		COMMAND_ERROR_IS_FATAL ANY
	)
	set(hex "[0-9A-Fa-f]")
	if(NOT headers MATCHES "uuid (${hex}+)-(${hex}+)-(${hex}+)-(${hex}+)-(${hex}+)")
		message(FATAL_ERROR "the stand-in plugin's ${arch} slice has no UUID")
	endif()
	string(CONCAT uuid
		"${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}" "${CMAKE_MATCH_3}" "${CMAKE_MATCH_4}" "${CMAKE_MATCH_5}"
	)
	string(LENGTH "${uuid}" length)
	if(NOT length EQUAL 32)
		message(FATAL_ERROR "the stand-in plugin's ${arch} UUID is not 16 bytes: ${uuid}")
	endif()
	string(REGEX REPLACE "(${hex}${hex})" "0x\\1, " bytes "${uuid}")
	string(REGEX REPLACE ", $" "" bytes "${bytes}")
	execute_process(
		COMMAND "${NM}" -arch ${arch} -g "${PLUGIN}"
		OUTPUT_VARIABLE symbols
		COMMAND_ERROR_IS_FATAL ANY
	)
	string(APPEND text "${directive} defined(${macro})\n#define STAND_IN_UUID {${bytes}}\n")
	foreach(name IN ITEMS Engine State GameMatchVtable PersonVtable DataBufferCtor ThreadRng MatchFactory
			MatchCreate MatchDeserialize MatchPrepare MatchRun MatchDtor MatchPoolFree)
		if(NOT symbols MATCHES "(^|\n)0*(${hex}+) [A-Za-z] _standIn${name}(\n|$)")
			message(FATAL_ERROR "the stand-in plugin's ${arch} slice has no _standIn${name}")
		endif()
		string(TOUPPER "${name}" upper)
		string(APPEND text "#define STAND_IN_${upper} 0x${CMAKE_MATCH_2}U\n")
	endforeach()
	set(directive "#elif")
endforeach()
string(APPEND text "#endif\n")
file(WRITE "${OUTPUT}" "${text}")
